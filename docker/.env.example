# Copiar como .env dentro de /docker y ajustar valores

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=taqueria_db
MYSQL_USER=taqueria
MYSQL_PASSWORD=changeme

REDIS_PORT=6379
MYSQL_PORT=3306

# Secreto compartido por los 5 microservicios para firmar/validar el JWT de sesion.
# Generar uno propio por entorno, por ejemplo: openssl rand -base64 32
JWT_SECRET=changeme-generar-con-openssl-rand-base64-32
# Duracion del token (horas). Ajustable sin tocar codigo.
JWT_EXPIRATION_HOURS=24
# true solo detras de HTTPS (Azure); en local por HTTP debe quedar en false.
COOKIE_SECURE=false
