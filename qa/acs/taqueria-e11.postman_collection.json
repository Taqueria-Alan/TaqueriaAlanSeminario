{
  "info": {
    "name": "Taquería Alan · E11 · Pedido y pago simulado",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en un ambiente de pruebas. Genera una cuenta sintética y un pedido con pago simulado. No usa credenciales reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "allowTestWrites",
      "value": "false"
    }
  ],
  "item": [
    {
      "name": "01 · Invitado sin sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test('Código HTTP esperado', () => pm.expect([401]).to.include(pm.response.code));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [], \"properties\": {}}));",
              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { pm.expect(respuestaQA).to.be.an(\"object\"); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "02 · Catálogo disponible",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test('Código HTTP esperado', () => pm.expect([200]).to.include(pm.response.code));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"idProducto\", \"precio\", \"disponible\"], \"properties\": {\"idProducto\": {\"type\": \"integer\"}, \"precio\": {\"type\": \"number\"}, \"disponible\": {\"type\": \"boolean\"}}}}));",
              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { const p=respuestaQA.find(x=>x.disponible && x.idProducto!==1 && x.precio>0); pm.expect(p,\"producto disponible\").to.exist; pm.collectionVariables.set(\"idProducto\",p.idProducto); pm.collectionVariables.set(\"precio\",p.precio); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/catalogo/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "catalogo",
            "productos"
          ]
        }
      }
    },
    {
      "name": "03 · Categorías disponibles",
      "event": [
        {
          "listen": "test",
          "script": {
