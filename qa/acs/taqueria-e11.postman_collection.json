    {
      "name": "04 · Registro sintético",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.variables.get(\"allowTestWrites\")!==\"true\") throw new Error(\"Habilita allowTestWrites únicamente en un entorno de prueba autorizado.\");",
              "const uuid=pm.variables.replaceIn(\"{{$randomUUID}}\");",
              "pm.collectionVariables.set(\"correoQA\",\"qa-acs-\"+uuid+\"@example.invalid\");",
              "pm.collectionVariables.set(\"claveQA\",\"Qa!\"+uuid);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test('Código HTTP esperado', () => pm.expect([200]).to.include(pm.response.code));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"id\", \"email\", \"rol\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"email\": {\"type\": \"string\"}, \"rol\": {\"type\": \"string\"}}}));",
              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { pm.expect(respuestaQA.rol).to.eql(\"CLIENTE\"); pm.expect(respuestaQA.email).to.eql(pm.collectionVariables.get(\"correoQA\")); pm.collectionVariables.set(\"idCliente\",respuestaQA.id); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"QA Newman ACS\", \"email\": \"{{correoQA}}\", \"telefono\": \"55550000\", \"password\": \"{{claveQA}}\"}"
        }
      }
    },
