          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"idCliente\": {{idCliente}}, \"tipo\": \"LLEVAR\", \"lineas\": [{\"idProducto\": {{idProducto}}, \"cantidad\": 1}], \"observaciones\": \"QA ACS Newman: pedido simulado, no preparar\"}"
        }
      }
