    {
      "name": "06 · Crear pedido de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test('Código HTTP esperado', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\": \"object\", \"required\": [\"id\", \"total\", \"estado\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"total\": {\"type\": \"number\"}, \"estado\": {\"type\": \"string\"}}}));",
              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { pm.expect(respuestaQA.estado).to.eql(\"RECIBIDO\"); pm.expect(respuestaQA.total).to.be.closeTo(Number(pm.collectionVariables.get(\"precio\")),0.01); pm.collectionVariables.set(\"idPedido\",respuestaQA.id); });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
