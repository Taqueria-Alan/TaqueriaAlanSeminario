              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { pm.expect(respuestaQA.id).to.eql(pm.collectionVariables.get(\"idCliente\")); pm.expect(respuestaQA.rol).to.eql(\"CLIENTE\"); });",
              "}"
            ]
