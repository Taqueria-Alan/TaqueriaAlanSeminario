              "pm.test('Esquema JSON', () => pm.response.to.have.jsonSchema({\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"idCategoria\"], \"properties\": {\"idCategoria\": {\"type\": \"integer\"}}}}));",
              "const respuestaQA = pm.response.json();",
              "pm.test('Contenido de negocio', () => { pm.expect(respuestaQA.length).to.be.greaterThan(0); });",
              "}"
            ]
